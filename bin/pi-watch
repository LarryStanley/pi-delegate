#!/usr/bin/env node
// The plugin's monitor: watches this session's async-dispatch completions and prints each
// one, which Claude Code delivers to the session as a notification.
//
// A wrapper script rather than a bare `tail` in monitors.json, for two reasons:
//
//   1. monitors.json interpolates only ${CLAUDE_PLUGIN_ROOT}, ${CLAUDE_PLUGIN_DATA} and
//      ${CLAUDE_PROJECT_DIR}. There is no session-id variable, so the per-session path can
//      only be worked out at run time, from the environment this process is handed.
//   2. `tail -F` on a path that does not exist retries forever without a word. That exact
//      silence already hid one bug here for a long time (a mangled ${HOME} on Windows), so
//      the file is created before tailing and anything unusual is announced rather than
//      swallowed.
import { spawn } from "node:child_process";
import { closeSync, mkdirSync, openSync, readdirSync, rmSync, statSync } from "node:fs";
import { dirname, join } from "node:path";
import { eventsLogPath, isSessionScoped, sharedEventsLogPath } from "../src/events-log.mjs";

const PRUNE_AFTER_MS = 7 * 24 * 60 * 60 * 1000;

const logPath = eventsLogPath();
mkdirSync(dirname(logPath), { recursive: true });
// Touch without truncating: another dispatch in this session may already have written to
// it, and `tail -n 0` starts from the end anyway.
closeSync(openSync(logPath, "a"));

if (!isSessionScoped()) {
  // Said out loud, not swallowed. Without a session id every open session tails one shared
  // file, so completions cross between them — and a session cannot resolve another's
  // session_id, so the notification it receives is one it can do nothing with.
  console.log(
    "pi-delegate: CLAUDE_CODE_SESSION_ID is not set for this monitor, so it is watching the " +
    `shared log (${sharedEventsLogPath()}). Async dispatch notifications may appear in other ` +
    "open sessions as well; a session_id from another session will not resolve in this one.",
  );
}

// Old sessions leave their log behind. Small files, but unbounded, and a directory of
// thousands of them is its own small mess.
try {
  const dir = dirname(logPath);
  for (const name of readdirSync(dir)) {
    const file = join(dir, name);
    if (file === logPath || !name.endsWith(".log")) continue;
    if (Date.now() - statSync(file).mtimeMs > PRUNE_AFTER_MS) rmSync(file, { force: true });
  }
} catch {
  // Pruning is housekeeping; never let it stop the watch from starting.
}

// Args array, no shell: nothing here goes through a second round of parsing, so a home
// directory containing a space, a backslash, or a shell metacharacter is just a path.
const child = spawn("tail", ["-n", "0", "-F", logPath], { stdio: ["ignore", "inherit", "inherit"] });

child.on("error", (error) => {
  console.log(`pi-delegate: could not start the completion watch (${error.message}). Async dispatches will still run; you will just not be notified when they finish.`);
  process.exit(1);
});
child.on("exit", (code) => process.exit(code ?? 0));

for (const signal of ["SIGINT", "SIGTERM"]) {
  process.on(signal, () => {
    child.kill(signal);
  });
}
